# Local preview uses SQLite. Supabase requires a separately provisioned project.
NEXT_PUBLIC_SITE_URL=http://localhost:7007
DATABASE_PATH=./data/impulsa.db
# Optional target for the migration supplied in supabase/schema.sql:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set these BEFORE first startup. Otherwise random local credentials are generated.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
